#modal-update-equity-value.modal.fade
  .modal-dialog
    .modal-content
      .modal-header
        %h3.modal-title
          Update Equity Value
      .modal-body
        .modal-body-content
          .bs-callout.bs-callout-info
            Modify this CBU equity account's equity value amount
          = number_field_tag :equity_value, @equity_account.data.to_h.with_indifferent_access[:equity_value], class: "form-control", id: "input-equity-value", step: "0.01"
          .message
      .modal-footer
        .controls
          %button#btn-confirm-update-equity-value.btn.btn-primary
            .fa.fa-check
            Confirm
          %button.btn{"data-bs-dismiss" => "modal", type: "button"}
            .fa.fa-times
            Cancel
