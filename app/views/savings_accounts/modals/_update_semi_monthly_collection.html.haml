#modal-update-semi-monthly-collection.modal.fade
  .modal-dialog
    .modal-content
      .modal-header
        %h3.modal-title
          Update Semi Monthly Collection
      .modal-body
        .modal-body-content
          .bs-callout.bs-callout-info
            Modify this account's semi monthly collection amount
          = number_field_tag :semi_monthly_collection, @savings_account.data.to_h.with_indifferent_access[:semi_monthly_collection], class: 'form-control', id: 'input-semi-monthly-collection', step: '0.01'
          .message
      .modal-footer
        .controls
          %button#btn-confirm-update-semi-monthly-collection.btn.btn-primary
            .fa.fa-check
            Confirm
          %button.btn{"data-bs-dismiss" => "modal", :type => "button"}
            .fa.fa-times
            Cancel
